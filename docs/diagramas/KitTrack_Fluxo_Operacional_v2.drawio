<mxfile host="app.diagrams.net" modified="2026-10-11T13:45:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="kittrack-flow-v2" name="Fluxo operacional"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="fa" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:13px;line-height:1.4&quot;&gt;&lt;b&gt;INICIAR&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #cbd5e1&quot;/&gt;Selecionar/cadastrar aula&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="500" y="40" width="300" height="90" as="geometry" /></mxCell><mxCell id="fb" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:13px;line-height:1.4&quot;&gt;&lt;b&gt;AVALIAR REGRAS&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #cbd5e1&quot;/&gt;Aplicar regras de câmera/microfone&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="500" y="170" width="300" height="100" as="geometry" /></mxCell><mxCell id="fc" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:13px;line-height:1.4&quot;&gt;&lt;b&gt;CONFLITO?&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #cbd5e1&quot;/&gt;Se regras incompatíveis, não aprovar automaticamente&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=13;shadow=0;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="320" height="110" as="geometry" /></mxCell><mxCell id="fd" value="&lt;div style=&